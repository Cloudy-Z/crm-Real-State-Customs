---
title: Owner Lead / Unit listing workflow data model — implemented
---
erDiagram
    CRM_LEAD ||--o{ REAL_ESTATE_UNIT : "owns via owner_lead (Owner only)"
    CRM_LEAD ||--o{ LEAD_INTEREST : "Buyer only"
    REAL_ESTATE_UNIT ||--o{ LEAD_INTEREST : "linked Buyer interests"
    CRM_LEAD ||--o{ LEAD_ACTION_EXECUTION : "Owner lead actions"
    REAL_ESTATE_UNIT ||--o{ LEAD_ACTION_EXECUTION : "Owner Unit-scoped actions"
    REAL_ESTATE_UNIT ||--o{ REAL_ESTATE_UNIT_DOCUMENT : "private evidence"
    REAL_ESTATE_UNIT ||--o{ UNIT_SCHEDULED_SHOWING : "Buyer showing projection"
    REAL_ESTATE_UNIT ||--o{ VIEW_LOG : "unique portal / Desk views"
    LEAD_ACTION_EXECUTION }o--o| EVENT : "calendar projection"

    CRM_LEAD {
        select party_type "Buyer or Owner"
        link status "read-only Buyer/Owner rollup"
        select interest_status "Owner qualification"
        int no_answer_consecutive_count
        int no_answer_total_count
        select last_call_outcome
    }
    REAL_ESTATE_UNIT {
        link owner_lead "Owner only"
        select status "Available/Reserved/Sold/Rented"
        select listing_status "Pricing/Documents/Listed/etc."
        select pricing_method "Owner Price / Agent Pricing"
        currency proposed_over_price
        text pricing_basis
        date last_verified_on
        date next_verification_due
        int active_buyer_interest_count
        int total_buyer_interest_count
        attach listing_agreement_file "private"
    }
    REAL_ESTATE_UNIT_DOCUMENT {
        select document_type "Ownership proof / Owner ID / legal"
        select document_status "Received / Verified"
        attach file "private"
    }
    LEAD_ACTION_EXECUTION {
        select scope_type "Lead / Interest / Batch / Unit"
        select action_type "Call / Add Property / Agent Pricing / Price Decision / Listing Documents"
        select purpose "Listing Intake / Price Proposal / Documents Collection / Availability Verification"
        link unit
        link seller_lead "technical legacy name; UI Owner Lead"
    }
    LEAD_INTEREST {
        link unit
        check is_active
        select workflow_status
    }
