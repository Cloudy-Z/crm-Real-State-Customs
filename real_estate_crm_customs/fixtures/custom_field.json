  "name": "CRM Lead-buyer_budget"
 },
 {
  "doctype": "Custom Field",
  "dt": "CRM Lead",
  "fieldname": "area_unit",
  "label": "Area Unit",
  "fieldtype": "Select",
  "options": "Sq M\nSq Ft",
  "default": "Sq M",
