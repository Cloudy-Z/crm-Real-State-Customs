[
 {
  "doctype": "Custom Field",
  "dt": "CRM Lead",
  "fieldname": "real_estate_section",
  "label": "Real Estate",
  "fieldtype": "Section Break",
  "insert_after": "lead_owner",
  "collapsible": 1,
  "name": "CRM Lead-real_estate_section"
 },
 {
  "doctype": "Custom Field",
  "dt": "CRM Lead",
  "fieldname": "party_type",
  "label": "Party Role",
  "fieldtype": "Select",
  "options": "Buyer\nSeller",
  "default": "Buyer",
  "insert_after": "real_estate_section",
  "in_list_view": 1,
  "in_standard_filter": 1,
  "name": "CRM Lead-party_type",
  "reqd": 1,
  "description": "Canonical Buyer/Seller role used by real-estate ownership and workflow rules."
 },
 {
  "doctype": "Custom Field",
  "dt": "CRM Lead",
  "fieldname": "whatsapp_number",
  "label": "WhatsApp Number",
  "fieldtype": "Phone",
  "insert_after": "mobile_no",
  "name": "CRM Lead-whatsapp_number"
 },
 {
  "doctype": "Custom Field",
  "dt": "CRM Lead",
  "fieldname": "selection_tier",
  "label": "Selection Tier",
  "fieldtype": "Select",
  "options": "\nA - Priority\nB - Qualified\nC - Nurture",
  "insert_after": "whatsapp_number",
  "name": "CRM Lead-selection_tier"
 },
 {
  "doctype": "Custom Field",
  "dt": "CRM Lead",
  "fieldname": "buyer_requirements_section",
  "label": "Buyer Requirements and Search Filters",
  "fieldtype": "Section Break",
  "insert_after": "selection_tier",
  "depends_on": "eval:doc.party_type == 'Buyer'",
  "collapsible": 1,
  "name": "CRM Lead-buyer_requirements_section"
 },
 {
  "doctype": "Custom Field",
  "dt": "CRM Lead",
  "fieldname": "buyer_budget",
  "label": "Budget",
  "fieldtype": "Currency",
  "insert_after": "buyer_requirements_section",
  "depends_on": "eval:doc.party_type == 'Buyer'",
  "name": "CRM Lead-buyer_budget"
 },
 {
  "doctype": "Custom Field",
  "dt": "CRM Lead",
  "fieldname": "preferred_unit_type",
  "label": "Preferred Unit Type",
  "fieldtype": "Link",
  "options": "Real Estate Unit Type",
  "insert_after": "buyer_budget",
  "depends_on": "eval:doc.party_type == 'Buyer'",
  "name": "CRM Lead-preferred_unit_type"
 },
 {
  "doctype": "Custom Field",
  "dt": "CRM Lead",
  "fieldname": "preferred_destination",
  "label": "Preferred Destination",
  "fieldtype": "Link",
  "options": "Real Estate Destination",
  "insert_after": "preferred_unit_type",
  "depends_on": "eval:doc.party_type == 'Buyer'",
  "name": "CRM Lead-preferred_destination",
  "link_filters": "[[\"Real Estate Destination\",\"is_active\",\"=\",1]]"
 },
 {
  "doctype": "Custom Field",
  "dt": "CRM Lead",
  "fieldname": "preferred_developer",
  "label": "Developer",
  "fieldtype": "Link",
  "options": "Property Developer",
  "insert_after": "preferred_destination",
  "depends_on": "eval:doc.party_type == 'Buyer'",
  "name": "CRM Lead-preferred_developer"
 },
 {
  "doctype": "Custom Field",
  "dt": "CRM Lead",
  "fieldname": "preferred_compound",
  "label": "Preferred Compound",
  "fieldtype": "Link",
  "options": "Real Estate Project",
  "insert_after": "preferred_developer",
  "depends_on": "eval:doc.party_type == 'Buyer'",
  "name": "CRM Lead-preferred_compound"
 },
 {
  "doctype": "Custom Field",
  "dt": "CRM Lead",
  "fieldname": "preferred_finishing_type",
  "label": "Finishing Type",
  "fieldtype": "Select",
  "options": "\nCore & Shell\nSemi-Finished\nFully Finished",
  "insert_after": "preferred_compound",
  "depends_on": "eval:doc.party_type == 'Buyer'",
  "name": "CRM Lead-preferred_finishing_type"
 },
 {
  "doctype": "Custom Field",
  "dt": "CRM Lead",
  "fieldname": "preferred_delivery_time",
  "label": "Delivery Time",
  "fieldtype": "Data",
  "insert_after": "preferred_finishing_type",
  "depends_on": "eval:doc.party_type == 'Buyer'",
  "name": "CRM Lead-preferred_delivery_time"
 },
 {
  "doctype": "Custom Field",
  "dt": "CRM Lead",
  "fieldname": "lead_age",
  "label": "Lead Age",
  "fieldtype": "Data",
  "insert_after": "preferred_delivery_time",
  "read_only": 1,
  "description": "Auto-updated every hour by the system.",
  "name": "CRM Lead-lead_age"
 },
 {
  "doctype": "Custom Field",
  "dt": "CRM Lead",
  "fieldname": "is_primary_buyer",
  "label": "Primary Buyer",
  "fieldtype": "Check",
  "insert_after": "lead_age",
  "depends_on": "eval:doc.party_type == 'Buyer'",
  "name": "CRM Lead-is_primary_buyer",
  "read_only": 1,
  "description": "System-derived from active standalone Primary Lead Interests."
 },
 {
  "doctype": "Custom Field",
  "dt": "CRM Lead",
  "fieldname": "interest_status",
  "label": "Buyer Qualification",
  "fieldtype": "Select",
  "options": "\nInterested\nNot Interested",
  "insert_after": "is_primary_buyer",
  "depends_on": "eval:doc.party_type == 'Buyer'",
  "read_only": 1,
  "in_list_view": 1,
  "description": "System-managed Lead qualification; individual lifecycle state is stored on Lead Interest.",
  "name": "CRM Lead-interest_status"
 },
 {
  "doctype": "Custom Field",
  "dt": "CRM Lead",
  "fieldname": "previous_status",
  "label": "Previous Status",
  "fieldtype": "Data",
  "insert_after": "interest_status",
  "hidden": 1,
  "read_only": 1,
  "description": "Legacy origin alias retained during workflow migration.",
  "name": "CRM Lead-previous_status"
 },
 {
  "doctype": "Custom Field",
  "dt": "CRM Lead",
  "fieldname": "workflow_origin_status",
  "label": "Workflow Origin Status",
  "fieldtype": "Data",
  "insert_after": "previous_status",
  "hidden": 1,
  "read_only": 1,
  "description": "Immutable New or Fresh Lead origin used by aggregate Lead rollup.",
  "name": "CRM Lead-workflow_origin_status"
 },
 {
  "doctype": "Custom Field",
  "dt": "CRM Lead",
  "fieldname": "no_answer_consecutive_count",
  "label": "Current No Answer Streak",
  "fieldtype": "Int",
  "insert_after": "last_call_outcome",
  "depends_on": "eval:doc.party_type == 'Buyer'",
  "read_only": 1,
  "name": "CRM Lead-no_answer_consecutive_count"
 },
 {
  "doctype": "Custom Field",
  "dt": "CRM Lead",
  "fieldname": "no_answer_total_count",
  "label": "Total No Answer Count",
  "fieldtype": "Int",
  "insert_after": "no_answer_consecutive_count",
  "depends_on": "eval:doc.party_type == 'Buyer'",
  "read_only": 1,
  "name": "CRM Lead-no_answer_total_count"
 },
 {
  "doctype": "Custom Field",
  "dt": "CRM Lead",
  "fieldname": "last_call_outcome",
  "label": "Last Call Outcome",
  "fieldtype": "Select",
  "options": "\nAnswered\nNo Answer\nWrong Number\nInvalid / Disconnected",
  "insert_after": "no_answer_total_count",
  "depends_on": "eval:doc.party_type == 'Buyer'",
  "read_only": 1,
  "name": "CRM Lead-last_call_outcome"
 },
 {
  "doctype": "Custom Field",
  "dt": "CRM Lead",
  "fieldname": "last_call_at",
  "label": "Last Call At",
  "fieldtype": "Datetime",
  "insert_after": "last_call_outcome",
  "depends_on": "eval:doc.party_type == 'Buyer'",
  "read_only": 1,
  "name": "CRM Lead-last_call_at"
 },
 {
  "doctype": "Custom Field",
  "dt": "CRM Lead",
  "fieldname": "interested_in_units",
  "label": "Interested in Units",
  "fieldtype": "Table",
  "options": "Lead Interested Unit",
  "insert_after": "last_call_at",
  "depends_on": "eval:doc.party_type == 'Buyer'",
  "name": "CRM Lead-interested_in_units"
 },
 {
  "doctype": "Custom Field",
  "dt": "User",
  "fieldname": "real_estate_agent_outreach_section",
  "label": "Real Estate Agent Outreach",
  "fieldtype": "Section Break",
  "insert_after": "user_emails",
  "collapsible": 1,
  "name": "User-real_estate_agent_outreach_section"
 },
 {
  "doctype": "Custom Field",
  "dt": "User",
  "fieldname": "real_estate_agent_whatsapp_number",
  "label": "Agent WhatsApp Number",
  "fieldtype": "Data",
  "insert_after": "real_estate_agent_outreach_section",
  "name": "User-real_estate_agent_whatsapp_number"
 },
 {
  "doctype": "Custom Field",
  "dt": "User",
  "fieldname": "real_estate_agent_outreach_email",
  "label": "Agent Outreach Email",
  "fieldtype": "Data",
  "options": "Email",
  "insert_after": "real_estate_agent_whatsapp_number",
  "name": "User-real_estate_agent_outreach_email"
 }
]
