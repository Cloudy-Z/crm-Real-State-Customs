  "name": "CRM Lead-is_primary_buyer"
 },
 {
  "doctype": "Custom Field",
  "dt": "CRM Lead",
  "fieldname": "no_answer_first_call",
  "label": "No Answer – 1st Call",
  "fieldtype": "Check",
  "insert_after": "is_primary_buyer",
  "depends_on": "eval:doc.party_type == 'Buyer'",
  "read_only": 1,
  "name": "CRM Lead-no_answer_first_call"
 },
 {
  "doctype": "Custom Field",
  "dt": "CRM Lead",
  "fieldname": "no_answer_second_call",
  "label": "No Answer – 2nd Call",
  "fieldtype": "Check",
  "insert_after": "no_answer_first_call",
