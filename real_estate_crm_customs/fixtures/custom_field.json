  "depends_on": "eval:doc.party_type == 'Buyer'",
  "name": "CRM Lead-preferred_compound"
 },
 {
  "doctype": "Custom Field",
  "dt": "CRM Lead",
  "fieldname": "preferred_finishing_type",
